+
+impl OriginReplay {
+    fn rebase(self, rows: u16, cols: u16, (row, col): (u16, u16)) -> (vt100::Parser, Option<PromptEnd>) {
+        let mut parser = vt100::Parser::new(rows, cols, usize::from(rows));
+        parser.process(format!("\x1b[{};{}H", row.min(rows), col.min(cols)).as_bytes());
+        let mut at = 0;
+        let mut anchor = None;
+        let mut marks = self.marks.into_iter().peekable();
+        let mut prompt = self.prompt;
+        while let Some(pos) = marks.peek().copied().into_iter().chain(prompt).min() {
+            parser.process(&self.bytes[at..pos]);
+            at = pos;
+            if prompt == Some(pos) {
+                let screen = parser.screen();
+                let (row, col) = screen.cursor_position();
+                anchor = Some(PromptEnd { row, col, prefix: screen.contents_between(row, 0, row, col) });
+                prompt = None;
+            } else {
+                marks.next();
+                if parser.screen().cursor_position().1 != 0 {
+                    parser.process(b"\r\n");
+                }
+            }
+        }
+        parser.process(&self.bytes[at..]);
+        (parser, anchor)
+    }
